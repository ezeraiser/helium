@@ -0,0 +1,249 @@
+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/performance_manager/policies/background_tab_trim_policy.h"
+
+#include <algorithm>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/process/process.h"
+#include "build/build_config.h"
+#include "chrome/browser/browser_process.h"
+#include "components/performance_manager/public/decorators/page_live_state_decorator.h"
+#include "components/performance_manager/public/user_tuning/prefs.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/common/process_type.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+#endif
+
+namespace performance_manager {
+
+namespace {
+
+// Graph events (frames being created while a page loads, tab switches, ...)
+// arrive in bursts; one evaluation after this delay covers all of them.
+constexpr base::TimeDelta kEventCoalescingDelay = base::Milliseconds(500);
+
+// Lower bound for the configured delay, in case the pref was hand-edited.
+constexpr base::TimeDelta kMinDelay = base::Seconds(1);
+
+}  // namespace
+
+BackgroundTabTrimPolicy::BackgroundTabTrimPolicy() = default;
+BackgroundTabTrimPolicy::~BackgroundTabTrimPolicy() = default;
+
+void BackgroundTabTrimPolicy::OnPassedToGraph(Graph* graph) {
+  graph->AddPageNodeObserver(this);
+  graph->AddFrameNodeObserver(this);
+  graph->AddProcessNodeObserver(this);
+
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    pref_change_registrar_.Init(local_state);
+    for (const char* pref :
+         {user_tuning::prefs::kBackgroundTabTrimEnabled,
+          user_tuning::prefs::kBackgroundTabTrimDelaySeconds}) {
+      pref_change_registrar_.Add(
+          pref, base::BindRepeating(&BackgroundTabTrimPolicy::OnPrefChanged,
+                                    base::Unretained(this)));
+    }
+  }
+  ReadPrefs();
+  ScheduleEvaluate();
+}
+
+void BackgroundTabTrimPolicy::OnTakenFromGraph(Graph* graph) {
+  deadline_timer_.Stop();
+  event_timer_.Stop();
+  pref_change_registrar_.Reset();
+  states_.clear();
+
+  graph->RemoveProcessNodeObserver(this);
+  graph->RemoveFrameNodeObserver(this);
+  graph->RemovePageNodeObserver(this);
+}
+
+void BackgroundTabTrimPolicy::OnPageNodeAdded(const PageNode* page_node) {
+  ScheduleEvaluate();
+}
+
+void BackgroundTabTrimPolicy::OnIsVisibleChanged(const PageNode* page_node) {
+  ForgetResumedProcesses();
+  ScheduleEvaluate();
+}
+
+void BackgroundTabTrimPolicy::OnIsAudibleChanged(const PageNode* page_node) {
+  ForgetResumedProcesses();
+  ScheduleEvaluate();
+}
+
+void BackgroundTabTrimPolicy::OnHasPictureInPictureChanged(
+    const PageNode* page_node) {
+  ForgetResumedProcesses();
+  ScheduleEvaluate();
+}
+
+void BackgroundTabTrimPolicy::OnPageNodeRemoved(const PageNode* page_node) {
+  ScheduleEvaluate();
+}
+
+void BackgroundTabTrimPolicy::OnFrameNodeAdded(const FrameNode* frame_node) {
+  ScheduleEvaluate();
+}
+
+void BackgroundTabTrimPolicy::OnFrameNodeRemoved(
+    const FrameNode* frame_node,
+    const FrameNode* previous_parent_frame_node,
+    const PageNode* previous_page_node,
+    const ProcessNode* previous_process_node,
+    const FrameNode* previous_parent_or_outer_document_or_embedder) {
+  ScheduleEvaluate();
+}
+
+void BackgroundTabTrimPolicy::OnBeforeProcessNodeRemoved(
+    const ProcessNode* process_node) {
+  states_.erase(process_node);
+}
+
+void BackgroundTabTrimPolicy::ReadPrefs() {
+  PrefService* local_state = g_browser_process->local_state();
+  enabled_ = false;
+  int delay_seconds = user_tuning::prefs::kDefaultBackgroundTabTrimDelaySeconds;
+  if (local_state) {
+    enabled_ = local_state->GetBoolean(
+        user_tuning::prefs::kBackgroundTabTrimEnabled);
+    delay_seconds = local_state->GetInteger(
+        user_tuning::prefs::kBackgroundTabTrimDelaySeconds);
+  }
+  delay_ = std::max(kMinDelay, base::Seconds(delay_seconds));
+}
+
+void BackgroundTabTrimPolicy::OnPrefChanged() {
+  ReadPrefs();
+  Evaluate();
+}
+
+void BackgroundTabTrimPolicy::ForgetResumedProcesses() {
+  for (auto it = states_.begin(); it != states_.end();) {
+    if (IsTrimCandidate(it->first)) {
+      ++it;
+    } else {
+      it = states_.erase(it);
+    }
+  }
+}
+
+void BackgroundTabTrimPolicy::ScheduleEvaluate() {
+  if (!enabled_ || event_timer_.IsRunning()) {
+    return;
+  }
+  event_timer_.Start(FROM_HERE, kEventCoalescingDelay,
+                     base::BindOnce(&BackgroundTabTrimPolicy::Evaluate,
+                                    base::Unretained(this)));
+}
+
+void BackgroundTabTrimPolicy::Evaluate() {
+  deadline_timer_.Stop();
+  event_timer_.Stop();
+
+  if (!enabled_) {
+    states_.clear();
+    return;
+  }
+
+  const base::TimeTicks now = base::TimeTicks::Now();
+  base::TimeTicks next_deadline = base::TimeTicks::Max();
+
+  for (const ProcessNode* process_node : GetOwningGraph()->GetAllProcessNodes()) {
+    if (process_node->GetProcessType() != content::PROCESS_TYPE_RENDERER) {
+      continue;
+    }
+
+    if (!IsTrimCandidate(process_node)) {
+      // Visible again (or never hidden): forget it, so that it is trimmed
+      // again the next time it goes out of sight.
+      states_.erase(process_node);
+      continue;
+    }
+
+    ProcessState& state = states_[process_node];
+    if (state.hidden_since.is_null()) {
+      state.hidden_since = now;
+    }
+    if (state.trimmed) {
+      continue;
+    }
+
+    const base::TimeTicks deadline = state.hidden_since + delay_;
+    if (deadline <= now) {
+      Trim(process_node);
+      state.trimmed = true;
+    } else {
+      next_deadline = std::min(next_deadline, deadline);
+    }
+  }
+
+  if (!next_deadline.is_max()) {
+    deadline_timer_.Start(FROM_HERE, next_deadline - now,
+                          base::BindOnce(&BackgroundTabTrimPolicy::Evaluate,
+                                         base::Unretained(this)));
+  }
+}
+
+bool BackgroundTabTrimPolicy::IsTrimCandidate(
+    const ProcessNode* process_node) const {
+  if (!process_node->GetProcess().IsValid()) {
+    return false;
+  }
+
+  bool has_page = false;
+  for (const FrameNode* frame_node : process_node->GetFrameNodes()) {
+    const PageNode* page_node = frame_node->GetPageNode();
+    if (!page_node) {
+      continue;
+    }
+    has_page = true;
+
+    if (page_node->IsVisible() || page_node->IsAudible() ||
+        frame_node->IsAudible() || page_node->HasPictureInPicture()) {
+      return false;
+    }
+
+    const PageLiveStateDecorator::Data* live_state =
+        PageLiveStateDecorator::Data::FromPageNode(page_node);
+    if (live_state &&
+        (live_state->IsCapturingVideo() || live_state->IsCapturingAudio() ||
+         live_state->IsCapturingWindow() || live_state->IsCapturingDisplay() ||
+         live_state->IsBeingMirrored())) {
+      return false;
+    }
+  }
+
+  // A process without pages (a spare one, or one that is still starting up)
+  // has nothing worth trimming yet.
+  return has_page;
+}
+
+void BackgroundTabTrimPolicy::Trim(const ProcessNode* process_node) {
+#if BUILDFLAG(IS_WIN)
+  const base::Process& process = process_node->GetProcess();
+  if (!process.IsValid()) {
+    return;
+  }
+  // (SIZE_T)-1 for both limits is the documented way to empty the working set,
+  // the same thing EmptyWorkingSet() does.
+  if (!::SetProcessWorkingSetSize(process.Handle(), static_cast<SIZE_T>(-1),
+                                  static_cast<SIZE_T>(-1))) {
+    static bool logged = false;
+    if (!logged) {
+      logged = true;
+      PLOG(WARNING) << "Failed to trim the working set of a background tab";
+    }
+  }
+#endif  // BUILDFLAG(IS_WIN)
+}
+
+}  // namespace performance_manager

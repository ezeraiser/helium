+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_BACKGROUND_TAB_TRIM_POLICY_H_
+#define CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_BACKGROUND_TAB_TRIM_POLICY_H_
+
+#include <map>
+
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/performance_manager/public/graph/frame_node.h"
+#include "components/performance_manager/public/graph/graph.h"
+#include "components/performance_manager/public/graph/page_node.h"
+#include "components/performance_manager/public/graph/process_node.h"
+#include "components/prefs/pref_change_registrar.h"
+
+namespace performance_manager {
+
+// Ezer: shrinks the working set of a renderer process once every page it
+// hosts has been out of sight for a while (10 seconds by default, see
+// prefs::kBackgroundTabTrimDelaySeconds).
+//
+// This does not discard anything: the pages stay loaded and keep their state,
+// so switching back to a tab does not reload it. Windows just moves the
+// process's pages to the standby list, from where they are faulted back in on
+// demand (cheap) or reclaimed when memory is needed, which is what makes the
+// process's memory figure drop. Chromium has a working set trimmer for
+// ChromeOS only; on other platforms WorkingSetTrimmer is a no-op, so this
+// policy talks to the OS directly.
+//
+// A process is left alone while any of its pages is visible, audible, in
+// Picture-in-Picture or capturing (camera, microphone, screen, tab mirroring),
+// and it is trimmed at most once per time it becomes fully hidden.
+//
+// The graph lives on the main thread, so the prefs are read directly.
+//
+// Rather than polling, the policy re-evaluates on page/frame/process events
+// (coalesced) and keeps a single timer armed for the earliest pending
+// deadline; with nothing pending there are no wakeups at all.
+class BackgroundTabTrimPolicy : public GraphOwned,
+                                public PageNodeObserver,
+                                public FrameNodeObserver,
+                                public ProcessNodeObserver {
+ public:
+  BackgroundTabTrimPolicy();
+  ~BackgroundTabTrimPolicy() override;
+
+  BackgroundTabTrimPolicy(const BackgroundTabTrimPolicy&) = delete;
+  BackgroundTabTrimPolicy& operator=(const BackgroundTabTrimPolicy&) = delete;
+
+  // GraphOwned:
+  void OnPassedToGraph(Graph* graph) override;
+  void OnTakenFromGraph(Graph* graph) override;
+
+  // PageNodeObserver:
+  void OnPageNodeAdded(const PageNode* page_node) override;
+  void OnIsVisibleChanged(const PageNode* page_node) override;
+  void OnIsAudibleChanged(const PageNode* page_node) override;
+  void OnHasPictureInPictureChanged(const PageNode* page_node) override;
+  void OnPageNodeRemoved(const PageNode* page_node) override;
+
+  // FrameNodeObserver:
+  void OnFrameNodeAdded(const FrameNode* frame_node) override;
+  void OnFrameNodeRemoved(
+      const FrameNode* frame_node,
+      const FrameNode* previous_parent_frame_node,
+      const PageNode* previous_page_node,
+      const ProcessNode* previous_process_node,
+      const FrameNode* previous_parent_or_outer_document_or_embedder) override;
+
+  // ProcessNodeObserver:
+  void OnBeforeProcessNodeRemoved(const ProcessNode* process_node) override;
+
+ private:
+  struct ProcessState {
+    // When the process was first seen with all of its pages hidden.
+    base::TimeTicks hidden_since;
+    // Whether it was already trimmed during this hidden period.
+    bool trimmed = false;
+  };
+
+  // Reads the prefs into `enabled_` and `delay_`.
+  void ReadPrefs();
+
+  // Reads the prefs and re-evaluates.
+  void OnPrefChanged();
+
+  // Drops the state of every process that is no longer a candidate (it became
+  // visible, audible, ...). Done right away, not through the coalescing delay,
+  // so that a tab that was shown only briefly is trimmed again when it is
+  // hidden again instead of being remembered as "already trimmed".
+  void ForgetResumedProcesses();
+
+  // Coalesces bursts of graph events into a single Evaluate().
+  void ScheduleEvaluate();
+
+  // Trims every process that has been hidden for long enough and re-arms the
+  // timer for the earliest remaining deadline.
+  void Evaluate();
+
+  // Whether `process_node` is a renderer whose pages are all hidden and idle.
+  bool IsTrimCandidate(const ProcessNode* process_node) const;
+
+  void Trim(const ProcessNode* process_node);
+
+  PrefChangeRegistrar pref_change_registrar_;
+  bool enabled_ = false;
+  base::TimeDelta delay_;
+
+  std::map<const ProcessNode*, ProcessState> states_;
+
+  // Fires at the earliest pending trim deadline.
+  base::OneShotTimer deadline_timer_;
+  // Fires shortly after graph events, to coalesce them.
+  base::OneShotTimer event_timer_;
+};
+
+}  // namespace performance_manager
+
+#endif  // CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_BACKGROUND_TAB_TRIM_POLICY_H_

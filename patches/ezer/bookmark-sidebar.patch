+// Command ids of the right-click menu. These live far above the ids handed out
+// to folder-menu entries (which count up from 1).
+constexpr int kCommandShowSidebar = 1000001;
+constexpr int kCommandExpandOnHover = 1000002;
+constexpr int kCommandAddSeparator = 1000004;
+constexpr int kCommandRemoveSeparator = 1000005;
+// One radio item per BookmarkSidebarView::Position; the position is added to
+// this base.
+constexpr int kCommandPositionBase = 1000010;
+constexpr int kCommandPositionSubmenu = 1000020;
+constexpr int kPositionRadioGroup = 1;
+
+// The browser's bookmark context menu with the sidebar's own commands (ids
+// from kCommandShowSidebar up) routed back to the sidebar.
+class SidebarContextMenu : public BookmarkContextMenu {
+ public:
+  SidebarContextMenu(
+      BookmarkSidebarView* sidebar,
+      views::Widget* parent_widget,
+      BrowserWindowInterface* browser,
+      Profile* profile,
+      const std::vector<raw_ptr<const bookmarks::BookmarkNode,
+                                VectorExperimental>>& selection,
+      bool can_paste,
+      base::RepeatingClosure on_closed)
+      : BookmarkContextMenu(parent_widget,
+                            browser,
+                            profile,
+                            BookmarkLaunchLocation::kAttachedBar,
+                            selection,
+                            /*close_on_remove=*/true,
+                            can_paste),
+        sidebar_(sidebar),
+        on_closed_(std::move(on_closed)) {}
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (IsSidebarCommand(command_id)) {
+      sidebar_->ExecuteCommand(command_id, event_flags);
+      return;
+    }
+    BookmarkContextMenu::ExecuteCommand(command_id, event_flags);
+  }
+
+  bool IsItemChecked(int command_id) const override {
+    return IsSidebarCommand(command_id)
+               ? sidebar_->IsCommandIdChecked(command_id)
+               : BookmarkContextMenu::IsItemChecked(command_id);
+  }
+
+  bool IsCommandEnabled(int command_id) const override {
+    return IsSidebarCommand(command_id)
+               ? true
+               : BookmarkContextMenu::IsCommandEnabled(command_id);
+  }
+
+  bool IsCommandVisible(int command_id) const override {
+    return IsSidebarCommand(command_id)
+               ? true
+               : BookmarkContextMenu::IsCommandVisible(command_id);
+  }
+
+  void OnMenuClosed(views::MenuItemView* menu) override {
+    BookmarkContextMenu::OnMenuClosed(menu);
+    on_closed_.Run();
+  }
+
+ private:
+  static bool IsSidebarCommand(int command_id) {
+    return command_id >= kCommandShowSidebar;
+  }
+
+  const raw_ptr<BookmarkSidebarView> sidebar_;
+  base::RepeatingClosure on_closed_;
+};
+
+constexpr int kButtonIconPadding = 5;
+constexpr int kButtonHeight = 16 + 2 * kButtonIconPadding;
+constexpr int kStripPadding = 3;
+// Widest a button of a top/bottom strip gets while its title is shown.
+constexpr int kMaxHorizontalButtonWidth = 200;
+constexpr int kButtonSpacing = 0;
+
+// A separator is an ordinary bookmark with this URL, so it is stored, synced
+// and reordered like any other one. The sidebar draws it as a thin line
+// instead of a button; elsewhere it is just a bookmark titled "---".
+constexpr char kSeparatorUrl[] = "about:blank#helium-separator";
+constexpr char16_t kSeparatorTitle[] = u"---";
+// Space a separator takes along the strip, and the margin its line leaves at
+// both ends across the strip.
+constexpr int kSeparatorSlot = 9;
+constexpr int kSeparatorLineInset = 6;
+
+bool IsSeparatorNode(const bookmarks::BookmarkNode* node) {
+  return node->is_url() && node->url().spec() == kSeparatorUrl;
+}
+
+// A thin line that runs across the strip: horizontal in a left/right column,
+// vertical in a top/bottom row.
+class SeparatorView : public views::View {
+  METADATA_HEADER(SeparatorView, views::View)
+
+ public:
+  void SetHorizontalLine(bool horizontal) {
+    if (horizontal_ != horizontal) {
+      horizontal_ = horizontal;
+      SchedulePaint();
+    }
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::Rect bounds = GetLocalBounds();
+    const SkColor color = GetColorProvider()->GetColor(kColorToolbarSeparator);
+    if (horizontal_) {
+      canvas->FillRect(
+          gfx::Rect(kSeparatorLineInset, bounds.height() / 2,
+                    std::max(0, bounds.width() - 2 * kSeparatorLineInset), 1),
+          color);
+    } else {
+      canvas->FillRect(
+          gfx::Rect(bounds.width() / 2, kSeparatorLineInset, 1,
+                    std::max(0, bounds.height() - 2 * kSeparatorLineInset)),
+          color);
+    }
+  }
+
+ private:
+  bool horizontal_ = true;
+};

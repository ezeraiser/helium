+PrefService* GetPrefs(BrowserWindowInterface* browser) {
+  return browser->GetProfile()->GetPrefs();
+}
+
+std::u16string GetNodeTitle(const bookmarks::BookmarkNode* node) {
+  if (!node->GetTitle().empty() || node->is_folder()) {
+    return node->GetTitle();
+  }
+  return base::UTF8ToUTF16(node->url().spec());
+}

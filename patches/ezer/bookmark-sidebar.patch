+BookmarkSidebarView::BookmarkSidebarView(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+  SetNotifyEnterExitOnChild(true);
+  // The expanded strip overlays the page, so it needs its own layer to be
+  // composited above the web contents.
+  SetPaintToLayer();
+  layer()->SetMasksToBounds(true);
+  SetBackground(views::CreateSolidBackground(kColorToolbar));
+
+  scroll_view_ = AddChildView(std::make_unique<views::ScrollView>());
+  scroll_view_->SetBackgroundColor(std::nullopt);
+  scroll_view_->SetDrawOverflowIndicator(false);
+  // The scroll bar modes and the contents orientation depend on the position;
+  // OnPrefChanged() below sets them.
+
+  auto contents = std::make_unique<views::BoxLayoutView>();
+  contents->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  contents->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  contents->SetInsideBorderInsets(gfx::Insets(kStripPadding));
+  contents->SetBetweenChildSpacing(kButtonSpacing);
+  contents_ = scroll_view_->SetContents(std::move(contents));
+
+  auto drop_indicator = std::make_unique<views::View>();
+  drop_indicator->SetVisible(false);
+  drop_indicator->SetCanProcessEventsWithinSubtree(false);
+  drop_indicator->SetProperty(views::kViewIgnoredByLayoutKey, true);
+  drop_indicator->SetPaintToLayer();
+  drop_indicator_ = AddChildView(std::move(drop_indicator));
+
+  set_context_menu_controller(this);
+  scroll_view_->set_context_menu_controller(this);
+  contents_->set_context_menu_controller(this);
+
+  model_ = BookmarkModelFactory::GetForBrowserContext(browser_->GetProfile());
+  if (model_) {
+    model_observation_.Observe(model_);
+  }
+
+  pref_change_registrar_.Init(GetPrefs(browser_));
+  for (const char* pref : {prefs::kHeliumBookmarkSidebarVisible,
+                           prefs::kHeliumBookmarkSidebarPosition,
+                           prefs::kHeliumBookmarkSidebarExpandOnHover}) {
+    pref_change_registrar_.Add(
+        pref, base::BindRepeating(&BookmarkSidebarView::OnPrefChanged,
+                                  base::Unretained(this)));
+  }
+
+  OnPrefChanged();
+  Rebuild();
+}
+
+BookmarkSidebarView::~BookmarkSidebarView() = default;
+
+bool BookmarkSidebarView::ShouldShow() const {
+  return GetPrefs(browser_)->GetBoolean(prefs::kHeliumBookmarkSidebarVisible);
+}
+
+BookmarkSidebarView::Position BookmarkSidebarView::GetPosition() const {
+  switch (
+      GetPrefs(browser_)->GetInteger(prefs::kHeliumBookmarkSidebarPosition)) {
+    case static_cast<int>(Position::kRight):
+      return Position::kRight;
+    case static_cast<int>(Position::kTop):
+      return Position::kTop;
+    case static_cast<int>(Position::kBottom):
+      return Position::kBottom;
+    default:
+      return Position::kLeft;
+  }
+}
+
+bool BookmarkSidebarView::IsHorizontal() const {
+  const Position position = GetPosition();
+  return position == Position::kTop || position == Position::kBottom;
+}
+
+int BookmarkSidebarView::GetCurrentThickness() const {
+  return expanded_ && !IsHorizontal() ? kExpandedWidth : kCollapsedThickness;
+}
+
+void BookmarkSidebarView::ToggleVisibility() {
+  GetPrefs(browser_)->SetBoolean(prefs::kHeliumBookmarkSidebarVisible,
+                                 !ShouldShow());
+}
+
+void BookmarkSidebarView::OnMouseEntered(const ui::MouseEvent& event) {
+  PrefService* prefs = GetPrefs(browser_);
+  if (expanded_ ||
+      !prefs->GetBoolean(prefs::kHeliumBookmarkSidebarExpandOnHover)) {
+    return;
+  }
+  expand_timer_.Start(
+      FROM_HERE,
+      base::Milliseconds(
+          prefs->GetInteger(prefs::kHeliumBookmarkSidebarExpandDelayMs)),
+      base::BindOnce(&BookmarkSidebarView::SetExpanded, base::Unretained(this),
+                     true));
+}
+
+void BookmarkSidebarView::OnMouseExited(const ui::MouseEvent& event) {
+  expand_timer_.Stop();
+  // While one of our popup menus is open the pointer is, by definition, not
+  // over us; collapsing underneath the menu would pull its anchor away. The
+  // menu-closed callback collapses the strip instead.
+  if (menu_runner_ && menu_runner_->IsRunning()) {
+    return;
+  }
+  SetExpanded(false);
+}
+
+bool BookmarkSidebarView::OnMouseWheel(const ui::MouseWheelEvent& event) {
+  // A row of buttons has nothing to scroll vertically, so let the plain wheel
+  // scroll it sideways.
+  if (!IsHorizontal() || event.y_offset() == 0 || event.x_offset() != 0) {
+    return false;
+  }
+  views::ScrollBar* scroll_bar = scroll_view_->horizontal_scroll_bar();
+  return scroll_bar &&
+         scroll_bar->ScrollByAmount(
+             event.y_offset() > 0 ? views::ScrollBar::ScrollAmount::kPrevLine
+                                  : views::ScrollBar::ScrollAmount::kNextLine);
+}
+
+void BookmarkSidebarView::BookmarkModelLoaded(bool ids_reassigned) {
+  Rebuild();
+}
+
+void BookmarkSidebarView::BookmarkModelBeingDeleted() {
+  model_observation_.Reset();
+  model_ = nullptr;
+  Rebuild();
+}
+
+void BookmarkSidebarView::BookmarkNodeMoved(
+    const bookmarks::BookmarkNode* old_parent,
+    size_t old_index,
+    const bookmarks::BookmarkNode* new_parent,
+    size_t new_index) {
+  Rebuild();
+}
+
+void BookmarkSidebarView::BookmarkNodeAdded(
+    const bookmarks::BookmarkNode* parent,
+    size_t index,
+    bool added_by_user) {
+  Rebuild();
+}
+
+void BookmarkSidebarView::BookmarkNodeRemoved(
+    const bookmarks::BookmarkNode* parent,
+    size_t old_index,
+    const bookmarks::BookmarkNode* node,
+    const std::set<GURL>& no_longer_bookmarked,
+    const base::Location& location) {
+  Rebuild();
+}
+
+void BookmarkSidebarView::BookmarkNodeChanged(
+    const bookmarks::BookmarkNode* node) {
+  Rebuild();
+}
+
+void BookmarkSidebarView::BookmarkNodeFaviconChanged(
+    const bookmarks::BookmarkNode* node) {
+  // Favicons load one by one at startup; rebuilding every button for each of
+  // them would be quadratic and would keep destroying the hovered button.
+  for (const Entry& entry : entries_) {
+    if (entry.node_id == node->id() && entry.button) {
+      entry.button->SetImageModel(views::Button::STATE_NORMAL, GetIcon(node));
+      return;
+    }
+  }
+}
+
+void BookmarkSidebarView::BookmarkNodeChildrenReordered(
+    const bookmarks::BookmarkNode* node) {
+  Rebuild();
+}
+
+void BookmarkSidebarView::BookmarkAllUserNodesRemoved(
+    const std::set<GURL>& removed_urls,
+    const base::Location& location) {
+  Rebuild();
+}
+
+bool BookmarkSidebarView::IsCommandIdChecked(int command_id) const {
+  switch (command_id) {
+    case kCommandShowSidebar:
+      return ShouldShow();
+    case kCommandExpandOnHover:
+      return GetPrefs(browser_)->GetBoolean(
+          prefs::kHeliumBookmarkSidebarExpandOnHover);
+    default:
+      if (command_id >= kCommandPositionBase &&
+          command_id < kCommandPositionBase + 4) {
+        return command_id - kCommandPositionBase ==
+               static_cast<int>(GetPosition());
+      }
+      return false;
+  }
+}
+
+void BookmarkSidebarView::ExecuteCommand(int command_id, int event_flags) {
+  PrefService* prefs = GetPrefs(browser_);
+  switch (command_id) {
+    case kCommandShowSidebar:
+      ToggleVisibility();
+      return;
+    case kCommandAddSeparator:
+      AddSeparator();
+      return;
+    case kCommandRemoveSeparator:
+      RemoveSeparator();
+      return;
+    case kCommandExpandOnHover:
+      prefs->SetBoolean(
+          prefs::kHeliumBookmarkSidebarExpandOnHover,
+          !prefs->GetBoolean(prefs::kHeliumBookmarkSidebarExpandOnHover));
+      return;
+    default:
+      break;
+  }
+
+  if (command_id >= kCommandPositionBase &&
+      command_id < kCommandPositionBase + 4) {
+    prefs->SetInteger(prefs::kHeliumBookmarkSidebarPosition,
+                      command_id - kCommandPositionBase);
+    return;
+  }
+
+  auto it = menu_command_to_node_id_.find(command_id);
+  if (it == menu_command_to_node_id_.end() || !model_) {
+    return;
+  }
+  if (const bookmarks::BookmarkNode* node =
+          bookmarks::GetBookmarkNodeByID(model_, it->second)) {
+    OpenNode(node, event_flags);
+  }
+}
+
+void BookmarkSidebarView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  // A clipboard check from an earlier right click must not open its menu now.
+  paste_check_weak_factory_.InvalidateWeakPtrs();
+  menu_runner_.reset();
+  native_context_menu_.reset();
+  menu_models_.clear();
+  menu_command_to_node_id_.clear();
+
+  context_node_id_ = 0;
+  context_on_separator_ = false;
+  for (const Entry& entry : entries_) {
+    if (entry.view == source) {
+      context_node_id_ = entry.node_id;
+      context_on_separator_ = entry.is_separator;
+      break;
+    }
+  }
+
+  // A separator is a placeholder bookmark that must not be opened or edited, so
+  // it only gets the sidebar's own items (incl. "Remove separator").
+  if (context_on_separator_) {
+    RunSidebarContextMenu(point, source_type);
+    return;
+  }
+
+  // Like the bookmark bar: a right click on a bookmark acts on it, one on the
+  // empty space acts on the whole bookmark bar.
+  std::vector<int64_t> node_ids;
+  // Id 0 means "empty space", but it is also the id of the bookmark tree's
+  // root node, which the browser's menu cannot act on (it has no parent), so
+  // it must not be looked up.
+  const bookmarks::BookmarkNode* context_node =
+      (model_ && context_node_id_ != 0)
+          ? bookmarks::GetBookmarkNodeByID(model_, context_node_id_)
+          : nullptr;
+  BookmarkMergedSurfaceService* service =
+      BookmarkMergedSurfaceServiceFactory::GetForProfile(
+          browser_->GetProfile());
+  if (context_node) {
+    node_ids.push_back(context_node->id());
+  } else if (service) {
+    for (const bookmarks::BookmarkNode* node : service->GetUnderlyingNodes(
+             BookmarkParentFolder::BookmarkBarFolder())) {
+      node_ids.push_back(node->id());
+    }
+  }
+  if (node_ids.empty() || !service) {
+    // The browser's menu needs at least one bookmark to anchor to.
+    RunSidebarContextMenu(point, source_type);
+    return;
+  }
+
+  std::vector<raw_ptr<const bookmarks::BookmarkNode, VectorExperimental>>
+      nodes;
+  for (int64_t id : node_ids) {
+    nodes.emplace_back(bookmarks::GetBookmarkNodeByID(model_, id));
+  }
+  auto parent_folder =
+      BookmarkContextMenuController::GetParentForNewNodes(nodes);
+  BookmarkUIOperationsHelperMergedSurfaces(service, parent_folder.get())
+      .CanPasteFromClipboard(
+          base::BindOnce(&BookmarkSidebarView::RunNativeContextMenu,
+                         paste_check_weak_factory_.GetWeakPtr(),
+                         std::move(node_ids),
+                         point, source_type));
+}
+
+void BookmarkSidebarView::RunNativeContextMenu(
+    std::vector<int64_t> node_ids,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type,
+    bool can_paste) {
+  std::vector<raw_ptr<const bookmarks::BookmarkNode, VectorExperimental>>
+      nodes;
+  for (int64_t id : node_ids) {
+    if (const bookmarks::BookmarkNode* node =
+            bookmarks::GetBookmarkNodeByID(model_, id)) {
+      nodes.emplace_back(node);
+    }
+  }
+  if (nodes.empty() || !GetWidget()) {
+    return;
+  }
+
+  native_context_menu_ = std::make_unique<SidebarContextMenu>(
+      this, GetWidget(), browser_, browser_->GetProfile(), nodes, can_paste,
+      base::BindRepeating(&BookmarkSidebarView::OnPopupMenuClosed,
+                          weak_ptr_factory_.GetWeakPtr()));
+
+  // Append the sidebar's items below the bookmark ones.
+  views::MenuItemView* menu = native_context_menu_->menu();
+  menu->AppendSeparator();
+  auto sidebar_menu = BuildSidebarMenuModel();
+  ui::SimpleMenuModel* sidebar_menu_ptr = sidebar_menu.get();
+  menu_models_.push_back(std::move(sidebar_menu));
+  ui::MenuModel* position_model = nullptr;
+  for (size_t i = 0; i < sidebar_menu_ptr->GetItemCount(); ++i) {
+    const int command_id = sidebar_menu_ptr->GetCommandIdAt(i);
+    views::MenuModelAdapter::AppendMenuItemFromModel(sidebar_menu_ptr, i, menu,
+                                                     command_id);
+    if (command_id == kCommandPositionSubmenu) {
+      position_model = sidebar_menu_ptr->GetSubmenuModelAt(i);
+    }
+  }
+  if (position_model) {
+    views::MenuItemView* item = menu->GetMenuItemByID(kCommandPositionSubmenu);
+    for (size_t i = 0; i < position_model->GetItemCount(); ++i) {
+      views::MenuModelAdapter::AppendMenuItemFromModel(
+          position_model, i, item, position_model->GetCommandIdAt(i));
+    }
+  }
+
+  native_context_menu_->RunMenuAt(point, source_type);
+}
+
+void BookmarkSidebarView::OnPopupMenuClosed() {
+  if (!IsMouseHovered()) {
+    SetExpanded(false);
+  }
+}
+
+void BookmarkSidebarView::RunSidebarContextMenu(
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  auto menu = BuildSidebarMenuModel();
+  ui::SimpleMenuModel* menu_ptr = menu.get();
+  menu_models_.push_back(std::move(menu));
+
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_ptr, views::MenuRunner::CONTEXT_MENU,
+      base::BindRepeating(&BookmarkSidebarView::OnPopupMenuClosed,
+                          weak_ptr_factory_.GetWeakPtr()));
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+std::unique_ptr<ui::SimpleMenuModel>
+BookmarkSidebarView::BuildSidebarMenuModel() {
+  auto menu = std::make_unique<ui::SimpleMenuModel>(this);
+  menu->AddCheckItem(
+      kCommandShowSidebar,
+      l10n_util::GetStringUTF16(IDS_SETTINGS_BOOKMARK_SIDEBAR_SHOW));
+  menu->AddCheckItem(
+      kCommandExpandOnHover,
+      l10n_util::GetStringUTF16(IDS_SETTINGS_BOOKMARK_SIDEBAR_EXPAND_ON_HOVER));
+
+  auto position_menu = std::make_unique<ui::SimpleMenuModel>(this);
+  position_menu->AddRadioItem(
+      kCommandPositionBase + static_cast<int>(Position::kLeft),
+      l10n_util::GetStringUTF16(IDS_SETTINGS_BOOKMARK_SIDEBAR_POSITION_LEFT),
+      kPositionRadioGroup);
+  position_menu->AddRadioItem(
+      kCommandPositionBase + static_cast<int>(Position::kRight),
+      l10n_util::GetStringUTF16(IDS_SETTINGS_BOOKMARK_SIDEBAR_POSITION_RIGHT),
+      kPositionRadioGroup);
+  position_menu->AddRadioItem(
+      kCommandPositionBase + static_cast<int>(Position::kTop),
+      l10n_util::GetStringUTF16(IDS_SETTINGS_BOOKMARK_SIDEBAR_POSITION_TOP),
+      kPositionRadioGroup);
+  position_menu->AddRadioItem(
+      kCommandPositionBase + static_cast<int>(Position::kBottom),
+      l10n_util::GetStringUTF16(IDS_SETTINGS_BOOKMARK_SIDEBAR_POSITION_BOTTOM),
+      kPositionRadioGroup);
+  ui::SimpleMenuModel* position_menu_ptr = position_menu.get();
+  menu_models_.push_back(std::move(position_menu));
+  menu->AddSubMenu(
+      kCommandPositionSubmenu,
+      l10n_util::GetStringUTF16(IDS_SETTINGS_BOOKMARK_SIDEBAR_POSITION),
+      position_menu_ptr);
+  menu->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu->AddItem(
+      kCommandAddSeparator,
+      l10n_util::GetStringUTF16(IDS_SETTINGS_BOOKMARK_SIDEBAR_ADD_SEPARATOR));
+  if (context_on_separator_) {
+    menu->AddItem(kCommandRemoveSeparator,
+                  l10n_util::GetStringUTF16(
+                      IDS_SETTINGS_BOOKMARK_SIDEBAR_REMOVE_SEPARATOR));
+  }
+  return menu;
+}
+
+void BookmarkSidebarView::Layout(PassKey) {
+  // An unbounded ScrollView never sizes its contents itself, so give them the
+  // full cross-axis extent and their preferred length along the strip.
+  const gfx::Size available = GetContentsBounds().size();
+  const gfx::Size preferred = contents_->GetPreferredSize();
+  const bool horizontal = IsHorizontal();
+  contents_->SetSize(horizontal ? gfx::Size(preferred.width(), available.height())
+                                : gfx::Size(available.width(), preferred.height()));
+  LayoutSuperclass<views::View>(this);
+  if (drop_indicator_ && drop_indicator_->GetVisible()) {
+    drop_indicator_->SetBoundsRect(drop_indicator_bounds_);
+  }
+}
+
+void BookmarkSidebarView::Rebuild() {
+  contents_->RemoveAllChildViews();
+  entries_.clear();
+  if (!model_ || !model_->loaded()) {
+    return;
+  }
+  AddButtonsFor(model_->bookmark_bar_node());
+  if (const bookmarks::BookmarkNode* account_node =
+          model_->account_bookmark_bar_node()) {
+    AddButtonsFor(account_node);
+  }
+  InvalidateLayout();
+}
+
+void BookmarkSidebarView::AddButtonsFor(const bookmarks::BookmarkNode* parent) {
+  for (const auto& child : parent->children()) {
+    Entry entry;
+    entry.node_id = child->id();
+    entry.title = GetNodeTitle(child.get());
+    if (IsSeparatorNode(child.get())) {
+      entry.is_separator = true;
+      auto separator = std::make_unique<SeparatorView>();
+      separator->set_context_menu_controller(this);
+      separator->set_drag_controller(this);
+      entry.view = contents_->AddChildView(std::move(separator));
+    } else {
+      entry.button = contents_->AddChildView(CreateButton(child.get()));
+      entry.view = entry.button;
+    }
+    entries_.push_back(std::move(entry));
+  }
+  UpdateButtons();
+}
+
+std::unique_ptr<views::LabelButton> BookmarkSidebarView::CreateButton(
+    const bookmarks::BookmarkNode* node) {
+  auto button = std::make_unique<views::LabelButton>(
+      base::BindRepeating(&BookmarkSidebarView::OnNodePressed,
+                          base::Unretained(this), node->id()),
+      std::u16string());
+  ConfigureInkDrop(button.get());
+  button->SetBorder(views::CreateEmptyBorder(
+      gfx::Insets::VH(kButtonIconPadding, kButtonIconPadding)));
+  button->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  button->SetImageLabelSpacing(8);
+  button->SetEnabledTextColors(kColorBookmarkBarForeground);
+  button->SetElideBehavior(gfx::ELIDE_TAIL);
+  button->SetTriggerableEventFlags(ui::EF_LEFT_MOUSE_BUTTON |
+                                   ui::EF_MIDDLE_MOUSE_BUTTON);
+  button->SetTooltipText(GetNodeTitle(node));
+  button->set_context_menu_controller(this);
+  button->set_drag_controller(this);
+
+  button->SetImageModel(views::Button::STATE_NORMAL, GetIcon(node));
+  return button;
+}
+
+ui::ImageModel BookmarkSidebarView::GetIcon(
+    const bookmarks::BookmarkNode* node) const {
+  if (node->is_folder()) {
+    return chrome::GetBookmarkFolderIcon(
+        chrome::BookmarkFolderIconType::kNormal, kColorBookmarkFolderIcon);
+  }
+  const gfx::Image& favicon = model_->GetFavicon(node);
+  return favicon.IsEmpty()
+             ? favicon::GetDefaultFaviconModel(kColorBookmarkBarBackground)
+             : ui::ImageModel::FromImage(favicon);
+}
+
+void BookmarkSidebarView::UpdateButtons() {
+  const bool horizontal = IsHorizontal();
+  // Extent across the strip, which is fixed: all buttons of a column share the
+  // strip's width, all buttons of a row its height.
+  const int cross_size =
+      GetCurrentThickness() - 2 * kStripPadding;
+  for (const Entry& entry : entries_) {
+    if (entry.is_separator) {
+      auto* separator = static_cast<SeparatorView*>(entry.view.get());
+      separator->SetHorizontalLine(!horizontal);
+      separator->SetPreferredSize(horizontal
+                                      ? gfx::Size(kSeparatorSlot, cross_size)
+                                      : gfx::Size(cross_size, kSeparatorSlot));
+      continue;
+    }
+    views::LabelButton* button = entry.button;
+    button->SetText(expanded_ ? entry.title : std::u16string());
+    if (!horizontal) {
+      button->SetPreferredSize(gfx::Size(cross_size, kButtonHeight));
+      continue;
+    }
+    // A button of a row is as wide as its content, capped; collapsed it is
+    // just the icon.
+    int width = kButtonHeight;
+    if (expanded_) {
+      button->SetPreferredSize(std::nullopt);
+      width = std::min(button->GetPreferredSize().width(),
+                       kMaxHorizontalButtonWidth);
+    }
+    button->SetPreferredSize(gfx::Size(width, cross_size));
+  }
+}
+
+void BookmarkSidebarView::OnPrefChanged() {
+  const bool horizontal = IsHorizontal();
+
+  // Buttons run down a left/right strip and along a top/bottom one.
+  contents_->SetOrientation(horizontal
+                                ? views::BoxLayout::Orientation::kHorizontal
+                                : views::BoxLayout::Orientation::kVertical);
+  scroll_view_->SetHorizontalScrollBarMode(
+      horizontal ? views::ScrollView::ScrollBarMode::kHiddenButEnabled
+                 : views::ScrollView::ScrollBarMode::kDisabled);
+  scroll_view_->SetVerticalScrollBarMode(
+      horizontal ? views::ScrollView::ScrollBarMode::kDisabled
+                 : views::ScrollView::ScrollBarMode::kHiddenButEnabled);
+  UpdateButtons();
+
+  // A hidden view receives no mouse-exit, so without this it would reappear
+  // still expanded (and overlaying the page) the next time it is shown.
+  if (expanded_ &&
+      (!ShouldShow() ||
+       !GetPrefs(browser_)->GetBoolean(
+           prefs::kHeliumBookmarkSidebarExpandOnHover))) {
+    expand_timer_.Stop();
+    SetExpanded(false);
+  }
+  InvalidateParentLayout();
+}
+
+void BookmarkSidebarView::SetExpanded(bool expanded) {
+  if (expanded_ == expanded) {
+    return;
+  }
+  expanded_ = expanded;
+  UpdateButtons();
+  InvalidateLayout();
+  InvalidateParentLayout();
+}
+
+void BookmarkSidebarView::InvalidateParentLayout() {
+  if (parent()) {
+    parent()->InvalidateLayout();
+  }
+}
+
+void BookmarkSidebarView::OnNodePressed(int64_t node_id,
+                                        const ui::Event& event) {
+  if (!model_) {
+    return;
+  }
+  const bookmarks::BookmarkNode* node =
+      bookmarks::GetBookmarkNodeByID(model_, node_id);
+  if (!node) {
+    return;
+  }
+  if (node->is_folder()) {
+    for (const Entry& entry : entries_) {
+      if (entry.node_id == node_id) {
+        ShowFolderMenu(entry.button, node);
+        break;
+      }
+    }
+    return;
+  }
+  OpenNode(node, event.flags());
+}
+
+const bookmarks::BookmarkNode* BookmarkSidebarView::GetNodeForView(
+    const views::View* view) const {
+  if (!model_) {
+    return nullptr;
+  }
+  for (const Entry& entry : entries_) {
+    if (entry.view == view) {
+      return bookmarks::GetBookmarkNodeByID(model_, entry.node_id);
+    }
+  }
+  return nullptr;
+}
+
+void BookmarkSidebarView::WriteDragDataForView(views::View* sender,
+                                               const gfx::Point& press_pt,
+                                               ui::OSExchangeData* data) {
+  const bookmarks::BookmarkNode* node = GetNodeForView(sender);

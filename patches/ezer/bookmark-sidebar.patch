+BookmarkSidebarView::BookmarkSidebarView(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+  SetNotifyEnterExitOnChild(true);
+  // The expanded strip overlays the page, so it needs its own layer to be
+  // composited above the web contents.
+  SetPaintToLayer();
+  layer()->SetMasksToBounds(true);
+  SetBackground(views::CreateSolidBackground(kColorToolbar));
+
+  scroll_view_ = AddChildView(std::make_unique<views::ScrollView>());
+  scroll_view_->SetBackgroundColor(std::nullopt);
+  scroll_view_->SetDrawOverflowIndicator(false);
+  // The scroll bar modes and the contents orientation depend on the position;
+  // OnPrefChanged() below sets them.
+
+  auto contents = std::make_unique<views::BoxLayoutView>();
+  contents->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  contents->SetCrossAxisAlignment(
+      views::BoxLayout::CrossAxisAlignment::kStretch);
+  contents->SetInsideBorderInsets(gfx::Insets(kStripPadding));
+  contents->SetBetweenChildSpacing(kButtonSpacing);
+  contents_ = scroll_view_->SetContents(std::move(contents));
+
+  set_context_menu_controller(this);
+  scroll_view_->set_context_menu_controller(this);
+  contents_->set_context_menu_controller(this);
+
+  model_ = BookmarkModelFactory::GetForBrowserContext(browser_->GetProfile());
+  if (model_) {
+    model_observation_.Observe(model_);
+  }
+
+  pref_change_registrar_.Init(GetPrefs(browser_));
+  for (const char* pref : {prefs::kHeliumBookmarkSidebarVisible,
+                           prefs::kHeliumBookmarkSidebarPosition,
+                           prefs::kHeliumBookmarkSidebarExpandOnHover}) {
+    pref_change_registrar_.Add(
+        pref, base::BindRepeating(&BookmarkSidebarView::OnPrefChanged,
+                                  base::Unretained(this)));
+  }
+
+  OnPrefChanged();
+  Rebuild();
+}
+
+BookmarkSidebarView::~BookmarkSidebarView() = default;
+
+bool BookmarkSidebarView::ShouldShow() const {
+  return GetPrefs(browser_)->GetBoolean(prefs::kHeliumBookmarkSidebarVisible);
+}
+
+BookmarkSidebarView::Position BookmarkSidebarView::GetPosition() const {
+  switch (
+      GetPrefs(browser_)->GetInteger(prefs::kHeliumBookmarkSidebarPosition)) {
+    case static_cast<int>(Position::kRight):
+      return Position::kRight;
+    case static_cast<int>(Position::kTop):
+      return Position::kTop;
+    case static_cast<int>(Position::kBottom):
+      return Position::kBottom;
+    default:
+      return Position::kLeft;
+  }
+}
+
+bool BookmarkSidebarView::IsHorizontal() const {
+  const Position position = GetPosition();
+  return position == Position::kTop || position == Position::kBottom;
+}
+
+int BookmarkSidebarView::GetCurrentThickness() const {
+  return expanded_ && !IsHorizontal() ? kExpandedWidth : kCollapsedThickness;
+}
+
+void BookmarkSidebarView::ToggleVisibility() {
+  GetPrefs(browser_)->SetBoolean(prefs::kHeliumBookmarkSidebarVisible,
+                                 !ShouldShow());
+}
+
+void BookmarkSidebarView::OnMouseEntered(const ui::MouseEvent& event) {
+  PrefService* prefs = GetPrefs(browser_);
+  if (expanded_ ||
+      !prefs->GetBoolean(prefs::kHeliumBookmarkSidebarExpandOnHover)) {
+    return;
+  }
+  expand_timer_.Start(
+      FROM_HERE,
+      base::Milliseconds(
+          prefs->GetInteger(prefs::kHeliumBookmarkSidebarExpandDelayMs)),
+      base::BindOnce(&BookmarkSidebarView::SetExpanded, base::Unretained(this),
+                     true));
+}
+
+void BookmarkSidebarView::OnMouseExited(const ui::MouseEvent& event) {
+  expand_timer_.Stop();
+  // While one of our popup menus is open the pointer is, by definition, not
+  // over us; collapsing underneath the menu would pull its anchor away. The
+  // menu-closed callback collapses the strip instead.
+  if (menu_runner_ && menu_runner_->IsRunning()) {
+    return;
+  }
+  SetExpanded(false);
+}
+
+bool BookmarkSidebarView::OnMouseWheel(const ui::MouseWheelEvent& event) {
+  // A row of buttons has nothing to scroll vertically, so let the plain wheel
+  // scroll it sideways.
+  if (!IsHorizontal() || event.y_offset() == 0 || event.x_offset() != 0) {
+    return false;
+  }
+  views::ScrollBar* scroll_bar = scroll_view_->horizontal_scroll_bar();
+  return scroll_bar &&
+         scroll_bar->ScrollByAmount(
+             event.y_offset() > 0 ? views::ScrollBar::ScrollAmount::kPrevLine
+                                  : views::ScrollBar::ScrollAmount::kNextLine);
+}
+
+void BookmarkSidebarView::BookmarkModelLoaded(bool ids_reassigned) {
+  Rebuild();
+}
+
+void BookmarkSidebarView::BookmarkModelBeingDeleted() {
+  model_observation_.Reset();
+  model_ = nullptr;
+  Rebuild();
+}

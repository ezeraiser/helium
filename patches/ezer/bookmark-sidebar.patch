+
+// Ezer: a slim strip, docked to the left, right, top or bottom edge of the
+// page area, that shows the bookmark bar's items as icons (favicons for
+// bookmarks, a folder glyph for folders) and optionally expands to show titles
+// while the mouse hovers over it. It is independent of the (horizontal)
+// bookmark bar and of the vertical tab strip, and is laid out by
+// BrowserViewTabbedLayoutImpl.
+//
+// On the left/right edges the strip is a column that widens when expanded
+// (overlaying the page). On the top/bottom edges it is a row of the same
+// thickness whose buttons grow to show their titles; the row keeps its height
+// and scrolls horizontally when the buttons do not fit.
+class BookmarkSidebarView : public views::View,
+                            public bookmarks::BookmarkModelObserver,
+                            public ui::SimpleMenuModel::Delegate,
+                            public views::ContextMenuController {
+  METADATA_HEADER(BookmarkSidebarView, views::View)
+
+ public:
+  // Which window edge the strip is docked to. Values match the position pref.
+  enum class Position { kLeft = 0, kRight = 1, kTop = 2, kBottom = 3 };
+
+  // Thickness (width for a left/right strip, height for a top/bottom one) of
+  // the icon-only strip. This is also what the layout reserves for the strip;
+  // the hover-expanded state of a side strip overlays the page content.
+  static constexpr int kCollapsedThickness = 40;
+  // Width of a left/right strip while hover-expanded.
+  static constexpr int kExpandedWidth = 240;
+
+  explicit BookmarkSidebarView(BrowserWindowInterface* browser);
+  BookmarkSidebarView(const BookmarkSidebarView&) = delete;
+  BookmarkSidebarView& operator=(const BookmarkSidebarView&) = delete;
+  ~BookmarkSidebarView() override;
+
+  // Whether the user has the sidebar turned on.
+  bool ShouldShow() const;
+  Position GetPosition() const;
+  // True for the top/bottom positions, where the buttons run in a row.
+  bool IsHorizontal() const;
+  bool IsExpanded() const { return expanded_; }
+
+  // Thickness the strip currently wants to occupy (>= kCollapsedThickness).
+  // Only a left/right strip gets thicker (wider) when expanded.
+  int GetCurrentThickness() const;
+
+  // Toggles the visibility pref; used by the keyboard shortcut / menus.
+  void ToggleVisibility();
+
+  // views::View:
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+  void OnMouseExited(const ui::MouseEvent& event) override;
+  bool OnMouseWheel(const ui::MouseWheelEvent& event) override;
+
+  // bookmarks::BookmarkModelObserver:
+  void BookmarkModelLoaded(bool ids_reassigned) override;
+  void BookmarkModelBeingDeleted() override;
+  void BookmarkNodeMoved(const bookmarks::BookmarkNode* old_parent,
+                         size_t old_index,

+
+bool BookmarkSidebarView::AreDropTypesRequired() {
+  return true;
+}
+
+bool BookmarkSidebarView::CanDrop(const ui::OSExchangeData& data) {
+  if (!model_ || !model_->loaded() ||
+      !GetPrefs(browser_)->GetBoolean(
+          bookmarks::prefs::kEditBookmarksEnabled)) {
+    return false;
+  }
+  drop_info_.emplace();
+  // One bookmark at a time, like the bookmark bar.
+  return drop_info_->data.Read(data) && drop_info_->data.size() == 1;
+}
+
+void BookmarkSidebarView::OnDragEntered(const ui::DropTargetEvent& event) {}
+
+int BookmarkSidebarView::OnDragUpdated(const ui::DropTargetEvent& event) {
+  if (!drop_info_) {
+    return ui::DragDropTypes::DRAG_NONE;
+  }
+  gfx::Point point = event.location();
+  views::View::ConvertPointToTarget(this, contents_, &point);
+  CalculateDropLocation(point, event, *drop_info_);
+  if (!drop_info_->valid) {
+    HideDropIndicator();
+    return ui::DragDropTypes::DRAG_NONE;
+  }
+  ShowDropIndicator(*drop_info_);
+  return static_cast<int>(drop_info_->operation);
+}
+
+void BookmarkSidebarView::OnDragExited() {
+  drop_info_.reset();
+  HideDropIndicator();
+}
+
+views::View::DropCallback BookmarkSidebarView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  HideDropIndicator();
+  if (!drop_info_ || !drop_info_->valid ||
+      drop_info_->operation == ui::mojom::DragOperation::kNone) {
+    drop_info_.reset();
+    return base::NullCallback();
+  }
+
+  DropInfo info = std::move(*drop_info_);
+  drop_info_.reset();
+  BookmarkParentFolder parent_folder = BookmarkParentFolder::BookmarkBarFolder();
+  if (info.into_folder_id != 0) {
+    const bookmarks::BookmarkNode* folder =
+        bookmarks::GetBookmarkNodeByID(model_, info.into_folder_id);
+    if (!folder || !folder->is_folder()) {
+      return base::NullCallback();
+    }
+    parent_folder = BookmarkParentFolder::FromFolderNode(folder);
+  }
+  const bool copy = info.operation == ui::mojom::DragOperation::kCopy;
+  return base::BindOnce(&BookmarkSidebarView::PerformDrop,
+                        drop_weak_factory_.GetWeakPtr(), std::move(info.data),
+                        parent_folder, info.index, copy);
+}
+
+void BookmarkSidebarView::CalculateDropLocation(
+    const gfx::Point& point_in_contents,
+    const ui::DropTargetEvent& event,
+    DropInfo& info) {
+  info.valid = false;
+  info.into_folder_id = 0;
+  BookmarkMergedSurfaceService* service =
+      BookmarkMergedSurfaceServiceFactory::GetForProfile(
+          browser_->GetProfile());
+  if (!service || !model_) {
+    return;
+  }
+
+  const bool horizontal = IsHorizontal();
+  const int pos = horizontal ? point_in_contents.x() : point_in_contents.y();
+
+  // The pointer is either over a folder button's middle half (drop into the
+  // folder) or before/after the middle of a button (drop in between).
+  size_t slot = entries_.size();  // insert before entries_[slot]
+  const bookmarks::BookmarkNode* into_folder = nullptr;
+  for (size_t i = 0; i < entries_.size(); ++i) {
+    const gfx::Rect bounds = entries_[i].view->bounds();
+    const int start = horizontal ? bounds.x() : bounds.y();
+    const int end = horizontal ? bounds.right() : bounds.bottom();
+    if (pos >= end) {
+      continue;
+    }
+    const int length = end - start;
+    const bookmarks::BookmarkNode* node =
+        bookmarks::GetBookmarkNodeByID(model_, entries_[i].node_id);
+    if (node && node->is_folder() && pos >= start + length / 4 &&
+        pos < end - length / 4) {
+      into_folder = node;
+      slot = i;
+    } else {
+      slot = pos < start + length / 2 ? i : i + 1;
+    }
+    break;
+  }
+
+  BookmarkParentFolder parent_folder = BookmarkParentFolder::BookmarkBarFolder();
+  if (into_folder) {
+    parent_folder = BookmarkParentFolder::FromFolderNode(into_folder);
+    info.into_folder_id = into_folder->id();
+    info.index = service->GetChildrenCount(parent_folder);
+    info.indicator = entries_[slot].view->bounds();
+  } else {
+    info.index = service->GetChildrenCount(parent_folder);
+    if (slot < entries_.size()) {
+      if (const bookmarks::BookmarkNode* before =
+              bookmarks::GetBookmarkNodeByID(model_, entries_[slot].node_id)) {
+        info.index = service->GetIndexOf(before);
+      }
+    }
+    // A 2 px line on the boundary the bookmark would be inserted at.
+    constexpr int kLine = 2;
+    if (entries_.empty()) {
+      info.indicator = gfx::Rect(kStripPadding, kStripPadding,
+                                 horizontal ? kLine : kButtonHeight,
+                                 horizontal ? kButtonHeight : kLine);
+    } else {
+      const bool after_last = slot >= entries_.size();
+      const gfx::Rect bounds =
+          entries_[after_last ? entries_.size() - 1 : slot].view->bounds();
+      if (horizontal) {
+        info.indicator = gfx::Rect((after_last ? bounds.right() : bounds.x()) - 1,
+                                   bounds.y(), kLine, bounds.height());
+      } else {
+        info.indicator = gfx::Rect(bounds.x(),
+                                   (after_last ? bounds.bottom() : bounds.y()) - 1,
+                                   bounds.width(), kLine);
+      }
+    }
+  }
+
+  info.operation = chrome::GetBookmarkDropOperation(
+      browser_->GetProfile(), event, info.data, parent_folder, info.index);
+  info.valid = info.operation != ui::mojom::DragOperation::kNone;
+}
+
+void BookmarkSidebarView::ShowDropIndicator(const DropInfo& info) {
+  gfx::RectF rect(info.indicator);
+  views::View::ConvertRectToTarget(contents_, this, &rect);
+  drop_indicator_bounds_ = gfx::ToEnclosingRect(rect);
+  if (info.into_folder_id != 0) {
+    drop_indicator_->SetBackground(nullptr);
+    drop_indicator_->SetBorder(
+        views::CreateSolidBorder(2, ui::kColorFocusableBorderFocused));
+  } else {
+    drop_indicator_->SetBorder(nullptr);
+    drop_indicator_->SetBackground(
+        views::CreateSolidBackground(ui::kColorFocusableBorderFocused));
+  }
+  drop_indicator_->SetBoundsRect(drop_indicator_bounds_);
+  drop_indicator_->SetVisible(true);
+}
+
+void BookmarkSidebarView::HideDropIndicator() {
+  if (drop_indicator_) {
+    drop_indicator_->SetVisible(false);
+  }
+}
+
+void BookmarkSidebarView::PerformDrop(
+    const bookmarks::BookmarkNodeData data,
+    const BookmarkParentFolder& parent_folder,
+    size_t index,
+    bool copy,
+    const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output_drag_op,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+  BookmarkMergedSurfaceService* service =
+      BookmarkMergedSurfaceServiceFactory::GetForProfile(
+          browser_->GetProfile());
+  if (!service) {
+    output_drag_op = ui::mojom::DragOperation::kNone;
+    return;
+  }
+  output_drag_op =
+      BookmarkUIOperationsHelperMergedSurfaces(service, &parent_folder)
+          .DropBookmarks(browser_->GetProfile(), data, index, copy,
+                         chrome::BookmarkReorderDropTarget::kBookmarkBarView,
+                         browser_);
+}
+
+void BookmarkSidebarView::AddSeparator() {
+  if (!model_ || !model_->loaded()) {
+    return;
+  }
+  const bookmarks::BookmarkNode* parent = model_->bookmark_bar_node();
+  size_t index = parent->children().size();
+  if (context_node_id_ != 0) {
+    if (const bookmarks::BookmarkNode* node =
+            bookmarks::GetBookmarkNodeByID(model_, context_node_id_)) {
+      if (node->parent()) {
+        parent = node->parent();
+        index = parent->children().size();
+        if (std::optional<size_t> node_index = parent->GetIndexOf(node)) {
+          index = *node_index + 1;
+        }
+      }
+    }
+  }
+  model_->AddURL(parent, index, kSeparatorTitle, GURL(kSeparatorUrl),
+                 /*meta_info=*/nullptr, /*creation_time=*/std::nullopt,
+                 /*uuid=*/std::nullopt, /*added_by_user=*/true);
+}
+
+void BookmarkSidebarView::RemoveSeparator() {
+  if (!model_ || context_node_id_ == 0) {
+    return;
+  }
+  if (const bookmarks::BookmarkNode* node =
+          bookmarks::GetBookmarkNodeByID(model_, context_node_id_);
+      node && IsSeparatorNode(node)) {
+    model_->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                   FROM_HERE);
+  }
+}
+
+void BookmarkSidebarView::OpenNode(const bookmarks::BookmarkNode* node,
+                                   int event_flags) {
+  if (!node->is_url() || IsSeparatorNode(node)) {
+    return;
+  }
+  browser_->OpenGURL(node->url(), ui::DispositionFromEventFlags(event_flags));
+}
+
+void BookmarkSidebarView::ShowFolderMenu(
+    views::View* anchor,
+    const bookmarks::BookmarkNode* folder) {
+  menu_runner_.reset();
+  menu_models_.clear();
+  menu_command_to_node_id_.clear();
+  next_menu_command_id_ = 1;
+
+  auto root = std::make_unique<ui::SimpleMenuModel>(this);
+  ui::SimpleMenuModel* root_ptr = root.get();
+  menu_models_.push_back(std::move(root));
+  BuildFolderMenu(root_ptr, folder);
+  if (root_ptr->GetItemCount() == 0) {
+    return;
+  }
+
+  // Open the menu next to the button, on the side that faces the page.
+  const gfx::Rect anchor_bounds = anchor->GetBoundsInScreen();
+  gfx::Point anchor_point;
+  views::MenuAnchorPosition anchor_position;
+  switch (GetPosition()) {
+    case Position::kRight:
+      anchor_point = anchor_bounds.origin();
+      anchor_position = views::MenuAnchorPosition::kTopRight;
+      break;
+    case Position::kTop:
+      anchor_point = anchor_bounds.bottom_left();
+      anchor_position = views::MenuAnchorPosition::kTopLeft;
+      break;
+    case Position::kBottom:
+      anchor_point = anchor_bounds.origin();
+      anchor_position = views::MenuAnchorPosition::kBottomCenter;
+      break;
+    case Position::kLeft:
+      anchor_point = anchor_bounds.top_right();
+      anchor_position = views::MenuAnchorPosition::kTopLeft;
+      break;
+  }
+  const gfx::Rect menu_anchor(anchor_point, gfx::Size());
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      root_ptr, /*run_types=*/0,
+      base::BindRepeating(&BookmarkSidebarView::OnPopupMenuClosed,
+                          weak_ptr_factory_.GetWeakPtr()));
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, menu_anchor, anchor_position,
+                          ui::mojom::MenuSourceType::kMouse);
+}
+
+void BookmarkSidebarView::BuildFolderMenu(
+    ui::SimpleMenuModel* menu,
+    const bookmarks::BookmarkNode* folder) {
+  for (const auto& child : folder->children()) {
+    if (child->is_folder()) {
+      auto submenu = std::make_unique<ui::SimpleMenuModel>(this);
+      ui::SimpleMenuModel* submenu_ptr = submenu.get();
+      menu_models_.push_back(std::move(submenu));
+      BuildFolderMenu(submenu_ptr, child.get());
+      if (submenu_ptr->GetItemCount() > 0) {
+        menu->AddSubMenu(next_menu_command_id_++, child->GetTitle(),
+                         submenu_ptr);
+      }
+    } else if (IsSeparatorNode(child.get())) {
+      menu->AddSeparator(ui::NORMAL_SEPARATOR);
+    } else {
+      const int command_id = next_menu_command_id_++;
+      menu_command_to_node_id_[command_id] = child->id();
+      menu->AddItem(command_id, GetNodeTitle(child.get()));
+    }
+  }
+}

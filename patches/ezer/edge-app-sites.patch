+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/edge_app/edge_app_navigation_throttle.h"
+
+#include <memory>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/logging.h"
+#include "base/path_service.h"
+#include "base/process/launch.h"
+#include "base/strings/escape.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "build/build_config.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/prefs/pref_service.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/net_errors.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "url/gurl.h"
+
+#if BUILDFLAG(IS_WIN)
+#include "base/base_paths_win.h"
+#endif
+
+namespace edge_app {
+
+namespace {
+
+// "netflix.com", "https://www.netflix.com/browse" -> "netflix.com".
+std::string NormalizeSite(std::string_view entry) {
+  std::string site = base::ToLowerASCII(entry);
+  if (site.find("://") != std::string::npos) {
+    GURL url(site);
+    site = url.is_valid() ? url.host() : std::string();
+  } else {
+    // Drop a path and a port.
+    site = site.substr(0, site.find_first_of("/:?#"));
+  }
+  if (base::StartsWith(site, "www.")) {
+    site.erase(0, 4);
+  }
+  return site;
+}
+
+bool HostMatchesAnySite(const std::string& host, const std::string& sites) {
+  if (host.empty()) {
+    return false;
+  }
+  for (const std::string& entry :
+       base::SplitString(sites, " ,;\r\n\t", base::TRIM_WHITESPACE,
+                         base::SPLIT_WANT_NONEMPTY)) {
+    const std::string site = NormalizeSite(entry);
+    if (site.empty()) {
+      continue;
+    }
+    if (host == site ||
+        (host.size() > site.size() && base::EndsWith(host, "." + site))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Blocking. Returns nullopt if Edge is not installed, else whether the
+// process could be started.
+std::optional<bool> FindEdgeAndLaunch(const GURL& url) {
+#if BUILDFLAG(IS_WIN)
+  base::FilePath edge;
+  for (int key : {base::DIR_PROGRAM_FILESX86, base::DIR_PROGRAM_FILES}) {
+    base::FilePath dir;
+    if (!base::PathService::Get(key, &dir)) {
+      continue;
+    }
+    base::FilePath candidate = dir.AppendASCII("Microsoft")
+                                   .AppendASCII("Edge")
+                                   .AppendASCII("Application")
+                                   .AppendASCII("msedge.exe");
+    if (base::PathExists(candidate)) {
+      edge = candidate;
+      break;
+    }
+  }
+  if (edge.empty()) {
+    return std::nullopt;
+  }
+  base::CommandLine command_line(edge);
+  command_line.AppendSwitchASCII("app", url.spec());
+  return base::LaunchProcess(command_line, base::LaunchOptions()).IsValid();
+#else
+  return std::nullopt;
+#endif
+}
+
+std::string BuildErrorPage() {
+  const std::string message =
+      base::EscapeForHTML(l10n_util::GetStringUTF8(IDS_EDGE_APP_NOT_FOUND));
+  return "<!doctype html><html><head><meta charset=\"utf-8\">"
+         "<meta name=\"viewport\" content=\"width=device-width\">"
+         "<style>body{font:16px system-ui,sans-serif;max-width:36em;"
+         "margin:20vh auto;padding:0 1em;color:#444}</style></head><body><p>" +
+         message + "</p></body></html>";
+}
+
+void ClosePageIfAlive(base::WeakPtr<content::WebContents> web_contents) {
+  if (web_contents) {
+    web_contents->ClosePage();
+  }
+}
+
+}  // namespace
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterBooleanPref(kEdgeAppEnabled, false);
+  registry->RegisterStringPref(kEdgeAppSites, "netflix.com");
+}
+
+// static
+void EdgeAppNavigationThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+#if BUILDFLAG(IS_WIN)
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  if (!handle.IsInOutermostMainFrame() || handle.IsInPrerenderedMainFrame() ||
+      handle.IsPost() || !handle.GetURL().SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  content::WebContents* web_contents = handle.GetWebContents();
+  if (!web_contents || web_contents->IsInnerWebContentsForGuest()) {
+    return;
+  }
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  if (!profile || profile->IsOffTheRecord() ||
+      !profile->GetPrefs()->GetBoolean(kEdgeAppEnabled)) {
+    return;
+  }
+  registry.AddThrottle(std::make_unique<EdgeAppNavigationThrottle>(registry));
+#endif
+}
+
+EdgeAppNavigationThrottle::EdgeAppNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+EdgeAppNavigationThrottle::~EdgeAppNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+EdgeAppNavigationThrottle::WillStartRequest() {
+  return Check();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+EdgeAppNavigationThrottle::WillRedirectRequest() {
+  return Check();
+}
+
+const char* EdgeAppNavigationThrottle::GetNameForLogging() {
+  return "EdgeAppNavigationThrottle";
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+EdgeAppNavigationThrottle::Check() {
+  content::NavigationHandle* handle = navigation_handle();
+  const GURL& url = handle->GetURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return PROCEED;
+  }
+  Profile* profile = Profile::FromBrowserContext(
+      handle->GetWebContents()->GetBrowserContext());
+  if (!profile->GetPrefs()->GetBoolean(kEdgeAppEnabled) ||
+      !HostMatchesAnySite(url.host(),
+                          profile->GetPrefs()->GetString(kEdgeAppSites))) {
+    return PROCEED;
+  }
+  // Finding and starting Edge touches the disk, so do it off the UI thread and
+  // hold the navigation until it is done.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&FindEdgeAndLaunch, url),
+      base::BindOnce(&EdgeAppNavigationThrottle::OnLaunchResult,
+                     weak_factory_.GetWeakPtr()));
+  return DEFER;
+}
+
+void EdgeAppNavigationThrottle::OnLaunchResult(std::optional<bool> launched) {
+  if (!launched.has_value()) {
+    CancelDeferredNavigation(ThrottleCheckResult(
+        BLOCK_REQUEST, net::ERR_BLOCKED_BY_CLIENT, BuildErrorPage()));
+    return;
+  }
+  if (!*launched) {
+    LOG(WARNING) << "EdgeApp: could not start Microsoft Edge";
+    Resume();
+    return;
+  }
+  // A link that opened a new, still empty tab would otherwise leave that tab
+  // behind.
+  content::WebContents* web_contents = navigation_handle()->GetWebContents();
+  const bool close_tab = web_contents->GetController().IsInitialNavigation();
+  base::WeakPtr<content::WebContents> weak_contents =
+      web_contents->GetWeakPtr();
+  CancelDeferredNavigation(CANCEL_AND_IGNORE);
+  if (close_tab) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ClosePageIfAlive, weak_contents));
+  }
+}
+
+}  // namespace edge_app

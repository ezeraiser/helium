+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EDGE_APP_EDGE_APP_NAVIGATION_THROTTLE_H_
+#define CHROME_BROWSER_EDGE_APP_EDGE_APP_NAVIGATION_THROTTLE_H_
+
+#include <optional>
+
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/navigation_throttle.h"
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace edge_app {
+
+// A boolean profile pref: open the sites in `kEdgeAppSites` in Microsoft Edge
+// as an app window (`msedge.exe --app=<url>`) instead of a Helium tab. Needed
+// for sites that require DRM licensing Helium does not have (e.g. Netflix).
+inline constexpr char kEdgeAppEnabled[] = "helium.edge_app.enabled";
+
+// A string profile pref: host names (or URLs), separated by spaces, commas or
+// new lines. A host matches itself and all of its subdomains.
+inline constexpr char kEdgeAppSites[] = "helium.edge_app.sites";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+// Whether Microsoft Edge is installed (always false off Windows). Touches the
+// disk.
+bool IsEdgeInstalled();
+
+// Sends top-level http(s) GET navigations to a configured site to Microsoft
+// Edge. Windows only; if Edge is not installed the navigation is blocked and
+// an error page that says so is shown.
+class EdgeAppNavigationThrottle : public content::NavigationThrottle {
+ public:
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+
+  explicit EdgeAppNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  ~EdgeAppNavigationThrottle() override;
+
+  EdgeAppNavigationThrottle(const EdgeAppNavigationThrottle&) = delete;
+  EdgeAppNavigationThrottle& operator=(const EdgeAppNavigationThrottle&) =
+      delete;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  ThrottleCheckResult WillRedirectRequest() override;
+  const char* GetNameForLogging() override;
+
+ private:
+  ThrottleCheckResult Check();
+  void OnLaunchResult(std::optional<bool> launched);
+
+  base::WeakPtrFactory<EdgeAppNavigationThrottle> weak_factory_{this};
+};
+
+}  // namespace edge_app
+
+#endif  // CHROME_BROWSER_EDGE_APP_EDGE_APP_NAVIGATION_THROTTLE_H_

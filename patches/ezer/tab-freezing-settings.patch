+++ b/chrome/browser/performance_manager/policies/tab_freezing_prefs_applier.cc
@@ -0,0 +1,84 @@
+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/performance_manager/policies/tab_freezing_prefs_applier.h"
+
+#include <algorithm>
+
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "chrome/browser/browser_process.h"
+#include "components/performance_manager/public/features.h"
+#include "components/performance_manager/public/user_tuning/prefs.h"
+#include "components/prefs/pref_service.h"
+
+namespace performance_manager {
+
+namespace {
+
+// Bounds for hand-edited prefs. A day is the largest interval: FreezingPolicy
+// picks a random phase of up to one interval as an `int` of milliseconds.
+constexpr int kMaxProtectedTabs = 100000;
+constexpr int kMinIntervalSeconds = 10;
+constexpr int kMaxIntervalSeconds = 24 * 60 * 60;
+
+// How long a frozen tab is awake each time, for the given interval. Never zero:
+// FreezingPolicy checks that the end of a wake-up period is after its start.
+base::TimeDelta UnfreezeDurationFor(int interval_seconds) {
+  if (interval_seconds >= kMaxIntervalSeconds) {
+    // "Never": woken up for a moment once a day.
+    return base::Milliseconds(1);
+  }
+  if (interval_seconds >= 300) {
+    return base::Seconds(3);
+  }
+  if (interval_seconds >= 60) {
+    return base::Seconds(4);
+  }
+  return base::Seconds(5);
+}
+
+}  // namespace
+
+TabFreezingPrefsApplier::TabFreezingPrefsApplier() = default;
+TabFreezingPrefsApplier::~TabFreezingPrefsApplier() = default;
+
+void TabFreezingPrefsApplier::OnPassedToGraph(Graph* graph) {
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    pref_change_registrar_.Init(local_state);
+    for (const char* pref :
+         {user_tuning::prefs::kTabFreezingProtectedTabs,
+          user_tuning::prefs::kTabFreezingUnfreezeIntervalSeconds}) {
+      pref_change_registrar_.Add(
+          pref, base::BindRepeating(&TabFreezingPrefsApplier::Apply,
+                                    base::Unretained(this)));
+    }
+  }
+  Apply();
+}
+
+void TabFreezingPrefsApplier::OnTakenFromGraph(Graph* graph) {
+  pref_change_registrar_.Reset();
+  features::ClearInfiniteTabsFreezingOverrides();
+}
+
+void TabFreezingPrefsApplier::Apply() {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state) {
+    return;
+  }
+  const int protected_tabs =
+      std::clamp(local_state->GetInteger(
+                     user_tuning::prefs::kTabFreezingProtectedTabs),
+                 1, kMaxProtectedTabs);
+  const int interval_seconds = std::clamp(
+      local_state->GetInteger(
+          user_tuning::prefs::kTabFreezingUnfreezeIntervalSeconds),
+      kMinIntervalSeconds, kMaxIntervalSeconds);
+  features::SetInfiniteTabsFreezingOverrides(
+      protected_tabs, base::Seconds(interval_seconds),
+      UnfreezeDurationFor(interval_seconds));
+}
+
+}  // namespace performance_manager

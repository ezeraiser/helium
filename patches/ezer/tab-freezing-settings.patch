+// Copyright 2026 The Helium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_TAB_FREEZING_PREFS_APPLIER_H_
+#define CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_TAB_FREEZING_PREFS_APPLIER_H_
+
+#include "components/performance_manager/public/graph/graph.h"
+#include "components/prefs/pref_change_registrar.h"
+
+namespace performance_manager {
+
+// Ezer: hands the "infinite tabs" freezing settings (how many recently used
+// tabs are never frozen, how often a frozen tab is woken up) from the local
+// state prefs, which the Performance settings page edits, to FreezingPolicy.
+// The values are applied right away and whenever a pref changes.
+class TabFreezingPrefsApplier : public GraphOwned {
+ public:
+  TabFreezingPrefsApplier();
+  ~TabFreezingPrefsApplier() override;
+
+  TabFreezingPrefsApplier(const TabFreezingPrefsApplier&) = delete;
+  TabFreezingPrefsApplier& operator=(const TabFreezingPrefsApplier&) = delete;
+
+  // GraphOwned:
+  void OnPassedToGraph(Graph* graph) override;
+  void OnTakenFromGraph(Graph* graph) override;
+
+ private:
+  void Apply();
+
+  PrefChangeRegistrar pref_change_registrar_;
+};
+
+}  // namespace performance_manager
+
+#endif  // CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_TAB_FREEZING_PREFS_APPLIER_H_
